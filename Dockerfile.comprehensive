# ===============================================
# COMPREHENSIVE DOCKERFILE FOR CODESANDBOX CLIENT
# ===============================================
# This Dockerfile builds the CodeSandbox client application
# in a multi-stage build process for production deployment

# ===============================================
# Stage 1: Build Dependencies and Base Setup
# ===============================================
FROM node:16-bullseye AS base

# Set working directory
WORKDIR /app

# Install system dependencies for building native modules
RUN apt-get update && apt-get install -y \
    git \
    python3 \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Enable corepack and prepare yarn
RUN corepack enable && corepack prepare yarn@1.22.19 --activate

# Set environment variables for optimal builds
ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=8192"

# Copy package management files
COPY package.json yarn.lock lerna.json ./
COPY .yarnrc ./

# ===============================================
# Stage 2: Install Dependencies
# ===============================================
FROM base AS dependencies

# Copy all source code to resolve workspace dependencies correctly
COPY . .

# Install all dependencies (including dev dependencies for building)
RUN yarn install --frozen-lockfile --production=false

# Ensure standalone packages have their dependencies installed
RUN yarn lerna run install-dependencies --stream --concurrency 1 || true

# Install dependencies for LinterWorker if the directory exists
RUN if [ -d "packages/app/src/app/overmind/effects/vscode/LinterWorker" ]; then \
        cd packages/app/src/app/overmind/effects/vscode/LinterWorker && yarn install; \
    fi

# ===============================================
# Stage 3: Build Application
# ===============================================
FROM dependencies AS builder

# Copy source code
COPY . .

# Copy configuration files
COPY babel.config.js ./
COPY Gulpfile.js ./
COPY env.sh ./

# Make env.sh executable
RUN chmod +x ./env.sh

# Build the application
RUN yarn build:deps && \
    yarn build:sandpack && \
    yarn build:prod

# Clean up cache and unnecessary files but keep dependencies intact for now
RUN yarn cache clean && \
    rm -rf .git && \
    rm -rf **/.git && \
    find . -name "*.md" -not -path "./node_modules/*" -delete && \
    find . -name "*.test.*" -not -path "./node_modules/*" -delete

# ===============================================
# Stage 4: Create Nginx Configuration
# ===============================================
FROM nginx:1.25.3-alpine AS nginx-config

# Copy optimized nginx configuration
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf

# ===============================================
# Stage 5: Production Runtime
# ===============================================
FROM nginx:1.25.3-alpine AS production

# Install additional utilities
RUN apk add --no-cache \
    curl \
    wget \
    ca-certificates

# Copy built application from builder stage
COPY --from=builder /app/www /usr/share/nginx/html

# Copy nginx configuration
COPY --from=nginx-config /etc/nginx/conf.d/default.conf /etc/nginx/conf.d/default.conf

# Create nginx user and set proper permissions
RUN addgroup -g 101 -S nginx && \
    adduser -S -D -H -u 101 -h /var/cache/nginx -s /sbin/nologin -G nginx -g nginx nginx && \
    chown -R nginx:nginx /usr/share/nginx/html && \
    chown -R nginx:nginx /var/cache/nginx && \
    chown -R nginx:nginx /var/log/nginx && \
    chown -R nginx:nginx /etc/nginx/conf.d

# Set proper permissions for web content
RUN chmod -R 755 /usr/share/nginx/html

# Expose port 80
EXPOSE 80

# Add health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost/health || exit 1

# Add labels for better container management
LABEL maintainer="CodeSandbox Team"
LABEL version="1.0"
LABEL description="CodeSandbox Client Application"
LABEL org.opencontainers.image.source="https://github.com/codesandbox/codesandbox-client"

# Run nginx in foreground
CMD ["nginx", "-g", "daemon off;"]

# ===============================================
# Development Stage (Optional)
# ===============================================
FROM node:18-bullseye AS development

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    python3 \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Enable corepack and prepare yarn
RUN corepack enable && corepack prepare yarn@1.22.19 --activate

# Copy package files
COPY package.json yarn.lock lerna.json ./
COPY .yarnrc ./

# Install dependencies
RUN yarn install --frozen-lockfile

# Copy source code
COPY . .

# Make scripts executable
RUN chmod +x ./env.sh

# Expose development port
EXPOSE 3000

# Development command
CMD ["yarn", "start"]